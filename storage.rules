rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow public read of uploaded images and assets
      allow read: if true;
      // Allow writes only by authenticated admins
      allow write: if request.auth != null && (
        request.auth.token.email in ['dnyanai2214@gmail.com', 'dcompany1410@gmail.com']
      );
    }
  }
}
